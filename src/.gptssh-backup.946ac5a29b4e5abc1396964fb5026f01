  .section-panel, .content-section { padding: 17px; border-radius: 11px; }
  .panel-heading h2 { font-size: 23px; }
  .section-heading h2 { font-size: 26px; }
  .server-row { min-height: 69px; gap: 9px; padding-inline: 10px; }
