@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');
@import 'tailwindcss';

:root {
  font-family: 'IBM Plex Sans', sans-serif;
  color: #efefea;
  background: #101112;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --bg: #101112;
  --sidebar: #141617;
  --panel: #191b1d;
  --line: #303335;
  --line-soft: #25282a;
  --text: #efefea;
  --muted: #999c9d;
  --subtle: #696d6f;
  --yellow: #f3c400;
  --yellow-dim: #b89600;
}

* { box-sizing: border-box; }
html { min-width: 320px; min-height: 100%; scroll-behavior: smooth; scroll-padding-top: 84px; }
body { min-width: 320px; min-height: 100vh; margin: 0; background: var(--bg); }
body::before { position: fixed; z-index: 0; inset: 0; background-image: linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px); background-size: 42px 42px; content: ''; pointer-events: none; }
button, a { font: inherit; -webkit-tap-highlight-color: transparent; }
button { color: inherit; }
a { color: inherit; text-decoration: none; }
button:focus-visible, a:focus-visible { outline: 2px solid var(--yellow); outline-offset: 3px; }

.site-shell { position: relative; z-index: 1; display: grid; min-height: 100vh; grid-template-columns: 246px minmax(0, 1fr); transition: grid-template-columns 240ms cubic-bezier(.2,.75,.25,1); }
.site-shell.is-sidebar-collapsed { grid-template-columns: 72px minmax(0, 1fr); }
.sidebar { position: sticky; top: 0; display: flex; height: 100vh; min-height: 480px; flex-direction: column; padding: 27px 17px 18px; border-right: 1px solid var(--line-soft); background: var(--sidebar); transition: padding 220ms ease; }
.sidebar-brand { display: flex; align-items: center; justify-content: space-between; gap: 8px; transition: gap 220ms ease; }
.brand { display: flex; align-items: center; gap: 11px; padding: 0 7px; transition: gap 220ms ease, padding 220ms ease; }
.sidebar-collapse-toggle { display: grid; width: 31px; height: 31px; flex: 0 0 auto; place-items: center; border: 1px solid transparent; border-radius: 4px; color: #85898a; background: transparent; cursor: pointer; transition: width 220ms ease, height 220ms ease, color 150ms ease, background 150ms ease, border-color 150ms ease; }
.sidebar-collapse-toggle:hover { border-color: var(--line); color: var(--text); background: #1d2021; }
.site-shell.is-sidebar-collapsed .sidebar { padding-right: 12px; padding-left: 12px; }
.site-shell.is-sidebar-collapsed .sidebar-brand { flex-direction: column; gap: 10px; }
.site-shell.is-sidebar-collapsed .brand { gap: 0; padding: 0; }
.site-shell.is-sidebar-collapsed .brand-mark { width: 24px; height: 24px; }
.site-shell.is-sidebar-collapsed .sidebar-collapse-toggle { width: 24px; height: 24px; }
.site-shell.is-sidebar-collapsed .brand-name,
.site-shell.is-sidebar-collapsed .nav-label,
.site-shell.is-sidebar-collapsed .help-label,
.site-shell.is-sidebar-collapsed .sidebar-version-label { max-width: 0; opacity: 0; transform: translateX(-5px); }
.site-shell.is-sidebar-collapsed .brand-name { max-height: 0; }
.site-shell.is-sidebar-collapsed .sidebar-caption { max-height: 0; margin: 0; opacity: 0; }
.site-shell.is-sidebar-collapsed .nav-arrow,
.site-shell.is-sidebar-collapsed .help-arrow { width: 0; max-width: 0; flex-basis: 0; margin-left: 0; opacity: 0; }
.site-shell.is-sidebar-collapsed .main-nav { margin-top: 20px; }
.site-shell.is-sidebar-collapsed .nav-link,
.site-shell.is-sidebar-collapsed .help-link { justify-content: center; gap: 0; padding: 0; }
.site-shell.is-sidebar-collapsed .sidebar-version { justify-content: center; padding-right: 0; padding-left: 0; }
.brand-mark { display: grid; width: 37px; height: 37px; flex: 0 0 auto; place-items: center; border-radius: 5px; color: #111; background: var(--yellow); }
.brand-name { display: flex; max-width: 180px; max-height: 48px; flex-direction: column; overflow: hidden; color: var(--text); font-family: 'Barlow Condensed', sans-serif; font-size: 21px; font-weight: 700; letter-spacing: .4px; line-height: .88; white-space: nowrap; transition: max-width 220ms ease, max-height 220ms ease, opacity 140ms ease, transform 180ms ease; }
.brand-name > span { color: var(--yellow); }
.brand-name small { margin-top: 6px; color: var(--subtle); font-family: 'IBM Plex Sans', sans-serif; font-size: 8px; font-weight: 600; letter-spacing: 1.65px; }
.sidebar-caption { max-height: 16px; overflow: hidden; margin: 58px 9px 13px; color: var(--subtle); font-size: 9px; font-weight: 700; letter-spacing: 1.5px; transition: max-height 180ms ease, margin 220ms ease, opacity 140ms ease; }
.main-nav { display: grid; gap: 5px; transition: margin-top 220ms ease; }
.admin-nav { display: grid; gap: 5px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line-soft); }
.nav-link, .help-link { position: relative; display: flex; min-height: 43px; align-items: center; gap: 12px; padding: 0 11px; border: 1px solid transparent; border-radius: 4px; color: #a8abad; font-size: 12px; font-weight: 500; transition: color 150ms ease, background 150ms ease, border-color 150ms ease, gap 220ms ease, padding 220ms ease; }
.nav-label, .help-label, .sidebar-version-label { max-width: 140px; overflow: hidden; white-space: nowrap; transition: max-width 220ms ease, opacity 140ms ease, transform 180ms ease; }
.nav-link::before { position: absolute; top: 9px; bottom: 9px; left: -1px; width: 2px; background: transparent; content: ''; }
.nav-link:hover, .help-link:hover { color: var(--text); background: #1d2021; }
.nav-link.is-active { border-color: #343536; color: var(--text); background: #202223; }
.nav-link.is-active::before { background: var(--yellow); }
.nav-link.is-active > svg:first-child { color: var(--yellow); }
.nav-arrow, .help-arrow { width: 14px; max-width: 14px; flex: 0 0 14px; margin-left: auto; color: var(--subtle); transition: width 220ms ease, max-width 220ms ease, flex-basis 220ms ease, margin 220ms ease, opacity 140ms ease; }
.sidebar-bottom { display: grid; gap: 12px; margin-top: auto; }
.help-link { width: 100%; background: transparent; cursor: pointer; text-align: left; }
.sidebar-bottom > .help-link > svg:first-child { color: var(--yellow); }
.sidebar-version { display: flex; align-items: center; gap: 8px; padding: 14px 11px 0; border-top: 1px solid var(--line-soft); color: var(--subtle); font-size: 8px; font-weight: 600; letter-spacing: 1.1px; transition: gap 220ms ease, padding 220ms ease; }
.version-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--yellow); box-shadow: 0 0 9px rgba(243,196,0,.4); }

.main-content { min-width: 0; }
.topbar { position: sticky; z-index: 5; top: 0; display: flex; height: 65px; align-items: center; justify-content: space-between; gap: 18px; padding: 0 clamp(20px, 4vw, 58px); border-bottom: 1px solid var(--line-soft); background: rgba(16,17,18,.94); backdrop-filter: blur(14px); }
.topbar-label { display: flex; align-items: center; gap: 8px; color: #a1a4a5; font-size: 9px; font-weight: 600; letter-spacing: 1.2px; }
.topbar-mark { width: 6px; height: 6px; border-radius: 50%; background: var(--yellow); }
.topbar-divider { color: #55595b; }
.topbar-actions { display: flex; align-items: center; gap: 9px; }
.route-enter-active, .route-leave-active { transition: opacity 190ms ease, transform 190ms ease; }
.route-enter-from, .route-leave-to { opacity: 0; transform: translateY(8px); }
.profile-content-enter-active, .profile-content-leave-active { transition: opacity 170ms ease, transform 170ms ease; }
.profile-content-enter-from, .profile-content-leave-to { opacity: 0; transform: translateY(5px); }
.profile-page > :nth-child(1), .profile-page > :nth-child(2), .profile-page > :nth-child(3), .profile-page > :nth-child(4) { animation: section-reveal 260ms ease both; }
.profile-page > :nth-child(1) { animation-delay: 35ms; }
