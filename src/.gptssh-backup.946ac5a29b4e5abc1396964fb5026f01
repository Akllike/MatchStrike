  .site-shell.is-sidebar-collapsed .brand-name, .site-shell.is-sidebar-collapsed .nav-label { max-width: 180px; max-height: 48px; opacity: 1; transform: none; }
  .site-shell.is-sidebar-collapsed .nav-link { justify-content: flex-start; gap: 7px; padding: 0 11px; }
  .site-shell.is-sidebar-collapsed .nav-arrow { width: 14px; max-width: 14px; flex-basis: 14px; margin-left: auto; opacity: 1; }
  .topbar { height: 58px; padding-inline: 16px; }
  .topbar-label { font-size: 8px; letter-spacing: .8px; }
  .topbar-actions { gap: 6px; }
  .login-button, .register-button { min-height: 35px; padding-inline: 10px; font-size: 10px; }
  .page-content { padding: 20px 15px 18px; }
  .dashboard-view { gap: 19px; }
  .welcome-section { min-height: 215px; padding: 25px 22px; border-radius: 12px; }
  .welcome-copy h1 { font-size: clamp(48px,12vw,68px); }
  .welcome-copy p { max-width: 310px; font-size: 11px; }
  .welcome-stamp { width: 82px; height: 82px; gap: 5px; }
  .welcome-stamp svg { width: 21px; }
